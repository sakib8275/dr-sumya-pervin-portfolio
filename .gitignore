*.log
.env
node_modules/
.DS_Store
Thumbs.db
data/
.wrangler/

# Compiled Functions bundle the test harness runs. Rebuilt by `npm test`.
.test-build/

# Local secrets for `wrangler pages dev` — never commit.
.dev.vars

# Playwright MCP scratch output (console logs, snapshots, screenshots) from
# browser verification runs. Transient, and the console logs can contain values
# typed into the page.
.playwright-mcp/

# F10 run artifacts (traces, failure screenshots, the HTML report). Regenerated
# by `npm run test:e2e`; traces embed full page content.
test-results/
playwright-report/

# Agent tooling scratch directories. Not part of this project.
.agents/
graphify-out/

# D1 exports (F11). Plaintext patient names, phone numbers, medical notes and the
# admin PIN hash. Never commit one — see docs/RUNBOOK-BACKUP.md.
backups/

# `gh run download` drops Actions logs in the repo root as logs_<run-id>/.
logs_*/
